# Copie para .env e gere uma chave com: uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_ENV=development
HOST=127.0.0.1
PORT=5001
# Em produção use APP_ENV=production e HTTPS; SECRET_KEY é obrigatória.
# Opcionais: FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, FIREBASE_PROJECT_ID, FIREBASE_DATABASE_URL
# RUNTIME_DIR=C:/caminho/para/runtime
